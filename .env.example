# Copia este fichero a .env y cambia lo que necesites. Todo es opcional.

# Servidor
PORT=8787
HOST=127.0.0.1
# URL con la que se abren los carritos del simulador (cámbiala si accedes desde otro equipo)
PUBLIC_BASE_URL=http://localhost:8787

# Vault de Obsidian (ruta relativa a la raíz del proyecto o absoluta)
VAULT_DIR=vault
# Zona horaria para las fechas del vault escritas sin zona (como las guarda Obsidian)
VAULT_TZ=Europe/Madrid

# Journal: pglite (por defecto, sin instalar nada) | postgres | memory
JOURNAL_DRIVER=pglite
DATA_DIR=data
# Solo con JOURNAL_DRIVER=postgres (y `npm install pg -w @to/server`)
# DATABASE_URL=postgres://usuario:clave@localhost:5432/ticket_orchestrator

# Protege la API y el dashboard con un token (recomendado si HOST no es 127.0.0.1)
# OPERATOR_TOKEN=

# Telegram (opcional). Lo más fácil: en el dashboard, Ajustes · Telegram (pega el token,
# pulsa Iniciar en el bot y elige tu chat): se guarda aquí solo y sin reiniciar.
# Guía: vault/00 Guía/Configurar Telegram.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fuentes oficiales de eventos (opcional, gratis). Lo más fácil: en el dashboard,
# Ajustes · Fuentes de eventos (pega la clave): se guarda aquí solo y sin reiniciar.
# Con ellas, al crear un evento eliges entre los próximos eventos del recinto (fecha,
# hora, apertura de la venta y límite de compra oficiales) y se vigila antes de la venta.
# Guía: vault/00 Guía/Buscar eventos oficiales y vigilar la venta.md
#   Ticketmaster: developer.ticketmaster.com → My Apps → Consumer Key
TICKETMASTER_API_KEY=
#   Partidos de LaLiga y Champions: football-data.org → Register → el token llega por email
FOOTBALL_DATA_TOKEN=

# Claude (IA): al crear un evento, eliges la web de venta y Claude busca sus eventos y lee
# fecha, hora, apertura de la venta, límite de compra y el recinto. Se pone desde el dashboard
# (Ajustes → Claude (IA)); se paga por consulta en platform.claude.com (Billing).
#   platform.claude.com → API keys → Create key (empieza por sk-ant-)
ANTHROPIC_API_KEY=
# Opcional: modelo fijo. Vacío = el Opus más reciente de tu cuenta.
ANTHROPIC_MODEL=

# Minutos que tiene una persona para responder una tarea de compra en asistencia manual
MANUAL_TASK_MINUTES=30

# Semilla por defecto del simulador y nivel de log (debug|info|warn|error)
SIM_SEED=1
LOG_LEVEL=info
