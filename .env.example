# Copia este fichero a .env y cambia lo que necesites. Todo es opcional.

# Servidor
PORT=8787
HOST=127.0.0.1
# URL con la que se abren los carritos del simulador (cámbiala si accedes desde otro equipo)
PUBLIC_BASE_URL=http://localhost:8787

# Vault de Obsidian (ruta relativa a la raíz del proyecto o absoluta)
VAULT_DIR=vault
# Zona horaria para las fechas del vault escritas sin zona (como las guarda Obsidian)
VAULT_TZ=Europe/Madrid

# Journal: pglite (por defecto, sin instalar nada) | postgres | memory
JOURNAL_DRIVER=pglite
DATA_DIR=data
# Solo con JOURNAL_DRIVER=postgres (y `npm install pg -w @to/server`)
# DATABASE_URL=postgres://usuario:clave@localhost:5432/ticket_orchestrator

# Protege la API y el dashboard con un token (recomendado si HOST no es 127.0.0.1)
# OPERATOR_TOKEN=

# Telegram (opcional): crea un bot con @BotFather y pon el id del chat del grupo
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Semilla por defecto del simulador y nivel de log (debug|info|warn|error)
SIM_SEED=1
LOG_LEVEL=info
