# Copia este archivo a prueba/.env y rellénalo. prueba/.env NO se sube a git.
# (También puedes conectar Telegram desde el propio panel: «Conectar Telegram».)

# --- Telegram (opcional: sin esto el aviso sale solo en el panel) -------------
# 1) Crea un bot con @BotFather y pega aquí el token.
TELEGRAM_BOT_TOKEN=
# 2) Escribe «hola» a tu bot y ejecuta: npm run prueba:chat-id   (o déjalo vacío y usa el panel)
TELEGRAM_CHAT_ID=

# --- Cuenta Real Madrid (opcional) -------------------------------------------
# Recomendado: déjalo vacío e inicia sesión tú en la ventana del bot la primera vez;
# la sesión queda guardada en data/prueba/perfil-navegador.
RM_EMAIL=
RM_PASSWORD=

# --- Valores por defecto del panel -------------------------------------------
# URL de «Comprar entradas» del partido del femenino, p. ej.
# https://tickets.realmadrid.com/realmadrid_femenino/select/3007478?hl=es-ES
# Vacía = el bot entra en tickets.realmadrid.com/realmadrid_femenino y elige el primer partido a la venta.
PRUEBA_URL_EVENTO=
PRUEBA_CANTIDAD=3
# Zonas por orden de preferencia (texto tal y como sale en la web), p. ej. "Lateral Oeste, Tribuna"
PRUEBA_ZONAS=
# Asientos seguidos en la misma fila (1 = sí, 0 = da igual)
PRUEBA_JUNTOS=1
# Precio máximo por entrada en euros (vacío = sin límite)
PRUEBA_PRECIO_MAX=

# --- Avanzado ----------------------------------------------------------------
PRUEBA_PORT=3000
# Minutos que el bot espera a que hagas login / resuelvas una verificación / pase la cola
PRUEBA_ESPERA_HUMANO_MIN=10
# Minutos que espera tu respuesta si la web no dice cuándo caduca el carrito
PRUEBA_RETENCION_CARRITO_MIN=10
